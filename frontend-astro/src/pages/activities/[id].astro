---
import Layout from '../../layouts/Layout.astro';
import EnrollmentStatus from '../../components/EnrollmentStatus.tsx';
import { backendUrl, participantId } from '../../config';

interface Activity {
	id: string;
	title: string;
	starts_at: string;
	capacity: number;
	availability: {
		available_slots: number;
	};
}

const { id } = Astro.params;
if (!id) return new Response('Actividad no encontrada.', { status: 404 });

let response: Response;
try {
	response = await fetch(`${backendUrl}/api/v2/activities/${id}/`);
} catch {
	return new Response('No pudimos cargar la actividad.', { status: 502 });
}

if (response.status === 404) return new Response('Actividad no encontrada.', { status: 404 });
if (!response.ok) return new Response('No pudimos cargar la actividad.', { status: 502 });
const activity: Activity = await response.json();
---

<Layout
	title={`${activity.title} | TP de Arquitectura Web`}
	description={`Detalle de la actividad ${activity.title}.`}
>
	<section class="content" aria-labelledby="activity-title">
		<div class="detail-heading">
			<a class="back-link" href="/">&larr; Volver a actividades</a>
			<p class="eyebrow">Detalle de actividad</p>
			<h1 id="activity-title">{activity.title}</h1>
			<p class="lead">Información de horarios y disponibilidad de esta propuesta académica.</p>
		</div>

		<article class="detail-card">
			<div class="detail-card__header">
				<span class="detail-label">Actividad</span>
				<div class="detail-card__meta">
					<span class="content-origin">HTML inicial</span>
					<span class="detail-status">Disponible</span>
				</div>
			</div>
			<dl class="detail-stats">
				<div>
					<dt class="stat-label">Fecha de inicio</dt>
					<dd class="detail-value">
						{new Date(activity.starts_at).toLocaleString('es-AR', { dateStyle: 'long', timeStyle: 'short' })}
					</dd>
				</div>
				<div>
					<dt class="stat-label">Capacidad total</dt>
					<dd class="detail-value">{activity.capacity} personas</dd>
				</div>
				<div>
					<dt class="stat-label">Cupos disponibles</dt>
					<dd class="detail-value detail-value--available">{activity.availability.available_slots}</dd>
				</div>
			</dl>
		</article>

		<EnrollmentStatus client:load activityId={activity.id} participantId={participantId} />
	</section>
</Layout>
