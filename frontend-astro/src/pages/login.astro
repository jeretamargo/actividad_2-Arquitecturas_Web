---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.tsx";
---

<Layout
  title="Ingresar | TP de Arquitectura Web"
  description="Inicio de sesión."
>
  <section class="content">
    <div class="page-heading">
      <h1>Ingresar</h1>
      <p class="lead">
        Iniciá sesión para gestionar tus inscripciones.
      </p>
    </div>

    <div class="activity-card login-card">
      <LoginForm client:only="react">
        <p slot="fallback">Cargando formulario…</p>
      </LoginForm>
    </div>
  </section>
</Layout>

<style>
  .login-card {
    max-width: 28rem;
  }

  :global(.login-form),
  :global(.login-form label) {
    display: grid;
    gap: 0.75rem;
  }

  :global(.login-form input) {
    padding: 0.65rem;
    font: inherit;
  }
</style>