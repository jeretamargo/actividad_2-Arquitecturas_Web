---
import { participantId } from '../config';

export interface Enrollment {
	id: string;
	activity_id: string;
	participant: {
		participant_id: string;
		enrolled_at: string;
	};
}

const enrollments: Enrollment[] = await fetch(
	`${import.meta.env.VITE_BACKEND_URL}/api/v2/me/enrollments/`,
	{ headers: { 'X-Participant-ID': participantId } },
).then((res) => res.json());
---

<section class="content content--compact" aria-labelledby="enrollments-title">
	<div class="page-heading">
		
		<p class="eyebrow">Seguimiento</p>
	
		<h1 id="enrollments-title">Mis inscripciones</h1>
		<p class="lead">Revisá las actividades en las que estás inscripto y la fecha de registro.</p>
	</div>

	
	<div class="page-actions page-actions--back">
		<a class="button button-secondary" href="/">Volver a actividades</a>
	</div>
	{enrollments.length > 0 ? (
		<div class="activities-grid">
			{enrollments.map((enrollment: Enrollment) => (
				<article class="activity-card">
					<div class="enrollment-id">ID de Inscripción #{enrollment.id}</div>
					<h2>ID de Actividad</h2>
					<p class="enrollment-reference">{enrollment.activity_id}</p>
					<dl class="activity-stats">
						<div>
							<dt class="stat-label"> ID de Participante</dt>
							<dd class="stat-value stat-value--small">{enrollment.participant.participant_id}</dd>
						</div>
						<div>
							<dt class="stat-label">Fecha de inscripción</dt>
							<dd class="stat-value stat-value--small">
								{new Date(enrollment.participant.enrolled_at).toLocaleString('es-AR', { dateStyle: 'medium', timeStyle: 'short' })}
							</dd>
						</div>
					</dl>
				</article>
			))}
		</div>
	) : (
		<div class="empty-state"><p>Todavía no hay inscripciones registradas.</p></div>
	)}
</section>
